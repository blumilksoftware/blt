{
  "name": "blumilksoftware/blt",
  "description": "Behat + Laravel toolbox",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Krzysztof Rewak",
      "email": "krzysztof.rewak@blumilk.pl"
    }
  ],
  "require": {
    "php": "^8.4",
    "behat/behat": "^3.31",
    "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/testing": "^10.0|^11.0|^12.0|^13.0",
    "phpunit/phpunit": "^10.1|^11.0|^12.0|^13.0",
    "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
    "symfony/css-selector": "^6.2|^7.1|^8.0",
    "symfony/dom-crawler": "^6.2|^7.1|^8.0"
  },
  "require-dev": {
    "blumilksoftware/codestyle": "^5.1.0",
    "illuminate/http": "^10.0|11.0|^12.0|^13.0",
    "symfony/http-foundation": "^6.2|^7.1|^8.0"
  },
  "autoload": {
    "psr-4": {
      "Blumilk\\BLT\\": "src/"
    }
  },
  "scripts": {
    "cs": "./vendor/bin/php-cs-fixer fix --dry-run --diff --config codestyle.php",
    "csf": "./vendor/bin/php-cs-fixer fix --diff --config codestyle.php",
    "test": "./vendor/bin/phpunit tests"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "providers": [
        "Blumilk\\BLT\\BLTServiceProvider"
      ]
    }
  }
}
